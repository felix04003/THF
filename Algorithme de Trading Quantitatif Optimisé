def verify_tws_running():
    """Vérifie si TWS est en cours d'exécution et accessible"""
    import socket
    
    def check_port(port):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        result = sock.connect_ex(('127.0.0.1', port))
        sock.close()
        return result == 0
    
    tws_ports = {
        'TWS Live': 7496,
        'TWS Paper': 7497,
        'Gateway Live': 4001,
        'Gateway Paper': 4002
    }
    
    print("\nVérification de TWS/Gateway :")
    print("-----------------------------")
    
    for name, port in tws_ports.items():
        status = "✓ En cours d'exécution" if check_port(port) else "✗ Non disponible"
        print(f"{name} (Port {port}): {status}")

def verify_api_settings():
    """Teste la connexion API et les paramètres"""
    from ibapi.client import EClient
    from ibapi.wrapper import EWrapper
    import threading
    import time
    
    class APITester(EWrapper, EClient):
        def __init__(self):
            EClient.__init__(self, self)
            self.api_status = {
                'connected': False,
                'socket_port': False,
                'api_enabled': False,
                'permissions': False
            }
            
        def error(self, reqId, errorCode, errorString):
            if errorCode == 502:  # Port non configuré
                print("✗ Erreur: Port TWS non configuré")
            elif errorCode == 501:  # API non activée
                print("✗ Erreur: API non activée dans TWS")
            else:
                print(f"! Message TWS: {errorString}")
        
        def nextValidId(self, orderId):
            self.api_status['connected'] = True
            self.api_status['api_enabled'] = True
            print("✓ Connexion API établie avec succès")
    
    def run_test():
        app = APITester()
        
        print("\nTest de la configuration API :")
        print("-----------------------------")
        
        try:
            # Test de connexion
            app.connect('127.0.0.1', 7497, clientId=1)
            
            # Démarrage du thread API
            api_thread = threading.Thread(target=app.run, daemon=True)
            api_thread.start()
            
            # Attente de la connexion
            timeout = 5
            start_time = time.time()
            while not app.api_status['connected'] and time.time() - start_time < timeout:
                time.sleep(0.1)
            
            # Vérification des résultats
            if app.api_status['connected']:
                print("✓ Socket port configuré correctement")
                print("✓ API activée et accessible")
            else:
                print("✗ Impossible d'établir la connexion")
                
        except Exception as e:
            print(f"✗ Erreur de connexion: {e}")
        finally:
            if app.isConnected():
                app.disconnect()
    
    run_test()

